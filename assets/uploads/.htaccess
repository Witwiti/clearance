# Uploaded avatars must never be executed as code.
<FilesMatch "(?i)\.(php|phtml|phar|php[0-9]|cgi|pl|py|sh|htaccess)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
